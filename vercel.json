{
  "functions": {
    "src/app/api/**/*": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/subscriptions/check-expiry",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/subscriptions/check-expiry-warnings",
      "schedule": "0 9 * * *"
    }
  ]
}
